# SmartBizLQ environment settings
# Copy this file to .env and fill in only what you need. Never commit .env.
# With nothing set, the app runs on a local SQLite database.

# --- MySQL (optional; leave commented to use SQLite) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=smartbizlq_db

# SQLite file used when MySQL is not configured
SQLITE_FILE=smartbizlq_local.db

# The account that registers with this email becomes Admin
ADMIN_EMAIL=

# --- SMTP for password-reset codes (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Development only: show reset codes on screen when SMTP is not set up
DEV_MODE=false
